model CheckInstrument {
  id                      String      @id @default(cuid())
  organizationId          String
  kind                    CheckKind   @default(THIRD_PARTY)
  number                  String
  bank                    String
  isElectronic            Boolean     @default(false)
  amount                  Decimal     @db.Decimal(14, 2)
  currency                String      @default("ARS")
  issueDate               DateTime?   @db.Date
  dueDate                 DateTime?   @db.Date
  account                 String?
  drawerName              String?
  status                  CheckStatus @default(IN_PORTFOLIO)
  receiptId               String?
  paymentOrderId          String?
  depositedBankAccountId  String?
  issuedFromBankAccountId String?
  depositedAt             DateTime?
  bouncedAt               DateTime?
  bounceReason            String?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  receipt               Receipt?               @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  paymentOrder          PaymentOrder?          @relation(fields: [paymentOrderId], references: [id], onDelete: SetNull)
  depositedBankAccount  BankAccount?           @relation("CheckDeposits", fields: [depositedBankAccountId], references: [id], onDelete: SetNull)
  issuedFromBankAccount BankAccount?           @relation("CheckIssues", fields: [issuedFromBankAccountId], references: [id], onDelete: SetNull)
  paymentOrderPayments  PaymentOrderPayment[]
  bankMovements         BankMovement[]
  rejectionFees         CheckRejectionFee[]

  @@unique([organizationId, bank, number])
  @@index([organizationId, status])
  @@index([organizationId, kind])
  @@index([receiptId])
  @@index([paymentOrderId])
  @@map("check_instruments")
}

model CheckRejectionFee {
  id                String   @id @default(cuid())
  organizationId    String
  checkInstrumentId String
  description       String
  amount            Decimal  @db.Decimal(14, 2)
  currency          String   @default("ARS")
  propertyId        String?
  passedToDrawer    Boolean  @default(false)
  createdAt         DateTime @default(now())

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  checkInstrument CheckInstrument @relation(fields: [checkInstrumentId], references: [id], onDelete: Cascade)
  property        Property?       @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([checkInstrumentId])
  @@map("check_rejection_fees")
}

model Receipt {
  id             String                 @id @default(cuid())
  organizationId String
  createdById    String?
  tenantId       String?
  number         String
  issueDate      DateTime               @db.Date
  status         TreasuryDocStatus      @default(DRAFT)
  paymentMethod  TreasuryPaymentMethod  @default(CASH)
  partyName      String?
  concept        String?
  currency       String                 @default("ARS")
  totalAmount    Decimal                @default(0) @db.Decimal(14, 2)
  checkNumber    String?
  checkBank      String?
  checkIssueDate DateTime?              @db.Date
  checkDueDate   DateTime?              @db.Date
  checkAccount   String?
  notes          String?
  postedAt       DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?                    @relation("ReceiptCreator", fields: [createdById], references: [id], onDelete: SetNull)
  tenant       User?                    @relation("ReceiptTenant", fields: [tenantId], references: [id], onDelete: SetNull)
  lines        ReceiptLine[]
  payments     ReceiptPayment[]
  checks       CheckInstrument[]
  billApps     ReceiptBillApplication[]
  ledgerPayments Payment[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([tenantId])
  @@map("receipts")
}

model ReceiptPayment {
  id                String                @id @default(cuid())
  receiptId         String
  method            TreasuryPaymentMethod
  amount            Decimal               @db.Decimal(14, 2)
  bankAccountId     String?
  checkNumber       String?
  checkBank         String?
  checkIssueDate    DateTime?             @db.Date
  checkDueDate      DateTime?             @db.Date
  checkAccount      String?
  isElectronicCheck Boolean               @default(false)
  sortOrder         Int                   @default(0)
  createdAt         DateTime              @default(now())

  receipt     Receipt      @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)

  @@index([receiptId])
  @@index([bankAccountId])
  @@map("receipt_payments")
}

model ReceiptLine {
  id          String  @id @default(cuid())
  receiptId   String
  contractId  String?
  propertyId  String?
  description String
  amount      Decimal @db.Decimal(14, 2)
  sortOrder   Int     @default(0)

  receipt  Receipt    @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  contract Contract?  @relation(fields: [contractId], references: [id], onDelete: SetNull)
  property Property?  @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([receiptId])
  @@index([contractId])
  @@index([propertyId])
  @@map("receipt_lines")
}

model ReceiptBillApplication {
  id           String   @id @default(cuid())
  receiptId    String
  tenantBillId String
  amount       Decimal  @db.Decimal(14, 2)
  paymentId    String?
  createdAt    DateTime @default(now())

  receipt    Receipt    @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  tenantBill TenantBill @relation(fields: [tenantBillId], references: [id], onDelete: Restrict)
  payment    Payment?   @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([receiptId, tenantBillId])
  @@index([tenantBillId])
  @@map("receipt_bill_applications")
}

model PaymentOrder {
  id             String                @id @default(cuid())
  organizationId String
  createdById    String?
  supplierId     String?
  number         String
  issueDate      DateTime              @db.Date
  status         TreasuryDocStatus     @default(DRAFT)
  paymentMethod  TreasuryPaymentMethod @default(CASH)
  partyName      String?
  concept        String?
  currency       String                @default("ARS")
  totalAmount    Decimal               @default(0) @db.Decimal(14, 2)
  checkNumber    String?
  checkBank      String?
  checkIssueDate DateTime?             @db.Date
  checkDueDate   DateTime?             @db.Date
  checkAccount   String?
  notes          String?
  postedAt       DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization    Organization                         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User?                                @relation("PaymentOrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  supplier        User?                                @relation("PaymentOrderSupplier", fields: [supplierId], references: [id], onDelete: SetNull)
  lines           PaymentOrderLine[]
  payments        PaymentOrderPayment[]
  checksDelivered CheckInstrument[]
  invoiceApps     PaymentOrderInvoiceApplication[]
  settlementApps  PaymentOrderSettlementApplication[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([supplierId])
  @@map("payment_orders")
}

model PaymentOrderPayment {
  id                String                @id @default(cuid())
  paymentOrderId    String
  method            TreasuryPaymentMethod
  amount            Decimal               @db.Decimal(14, 2)
  bankAccountId     String?
  checkInstrumentId String?
  isOwnCheck        Boolean               @default(false)
  checkNumber       String?
  checkBank         String?
  checkIssueDate    DateTime?             @db.Date
  checkDueDate      DateTime?             @db.Date
