model CashRegister {
  id             String           @id @default(cuid())
  organizationId String
  type           CashRegisterType
  name           String
  currency       String           @default("ARS")
  balance        Decimal          @default(0) @db.Decimal(14, 2)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions     CashSession[]
  movements    CashMovement[]

  @@unique([organizationId, type, currency])
  @@index([organizationId, type])
  @@map("cash_registers")
}

model CashSession {
  id                String            @id @default(cuid())
  organizationId    String
  registerId        String
  number            String
  businessDate      DateTime          @db.Date
  status            CashSessionStatus @default(OPEN)
  currency          String            @default("ARS")
  openingBalance    Decimal           @default(0) @db.Decimal(14, 2)
  expectedBalance   Decimal?          @db.Decimal(14, 2)
  countedBalance    Decimal?          @db.Decimal(14, 2)
  difference        Decimal?          @db.Decimal(14, 2)
  transferredAmount Decimal?          @db.Decimal(14, 2)
  notes             String?
  openedAt          DateTime          @default(now())
  closedAt          DateTime?
  openedById        String?
  closedById        String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  register     CashRegister   @relation(fields: [registerId], references: [id], onDelete: Restrict)
  openedBy     User?          @relation("CashSessionOpener", fields: [openedById], references: [id], onDelete: SetNull)
  closedBy     User?          @relation("CashSessionCloser", fields: [closedById], references: [id], onDelete: SetNull)
  movements    CashMovement[]

  @@unique([organizationId, number])
  @@index([organizationId, status, businessDate])
  @@index([registerId])
  @@map("cash_sessions")
}

model CashMovement {
  id              String           @id @default(cuid())
  organizationId  String
  registerId      String
  sessionId       String?
  type            CashMovementType
  amount          Decimal          @db.Decimal(14, 2)
  balanceAfter    Decimal?         @db.Decimal(14, 2)
  description     String
  occurredAt      DateTime         @default(now())
  receiptId       String?
  paymentOrderId  String?
  sourceSessionId String?
  createdById     String?
  createdAt       DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  register     CashRegister @relation(fields: [registerId], references: [id], onDelete: Restrict)
  session      CashSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("CashMovementCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([registerId, occurredAt])
  @@index([sessionId])
  @@map("cash_movements")
}

model BankAccount {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  bankName       String
  accountNumber  String?
  cbu            String?
  alias          String?
  currency       String   @default("ARS")
  balance        Decimal  @default(0) @db.Decimal(14, 2)
  isActive       Boolean  @default(true)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  movements            BankMovement[]
  receiptPayments      ReceiptPayment[]
  paymentOrderPayments PaymentOrderPayment[]
  depositedChecks      CheckInstrument[]     @relation("CheckDeposits")
  issuedChecks         CheckInstrument[]     @relation("CheckIssues")

  @@index([organizationId, isActive])
  @@map("bank_accounts")
}

model BankMovement {
  id                String           @id @default(cuid())
  organizationId    String
  bankAccountId     String
  type              BankMovementType
  amount            Decimal          @db.Decimal(14, 2)
  balanceAfter      Decimal?         @db.Decimal(14, 2)
  description       String
  occurredAt        DateTime         @default(now())
  receiptId         String?
  paymentOrderId    String?
  checkInstrumentId String?
  createdById       String?
  createdAt         DateTime         @default(now())

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bankAccount     BankAccount      @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  checkInstrument CheckInstrument? @relation(fields: [checkInstrumentId], references: [id], onDelete: SetNull)
  createdBy       User?            @relation("BankMovementCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  @@index([bankAccountId, occurredAt])
  @@map("bank_movements")
}
