  checkInstrument CheckInstrument? @relation(fields: [checkInstrumentId], references: [id], onDelete: Restrict)

  @@index([paymentOrderId])
  @@index([bankAccountId])
  @@index([checkInstrumentId])
  @@map("payment_order_payments")
}

model PaymentOrderLine {
  id             String  @id @default(cuid())
