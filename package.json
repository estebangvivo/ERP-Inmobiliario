    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.22",
    "playwright": "^1.51.0",
    "tailwindcss": "^4",
    "typescript": "^5"
