{
  "name": "erp-inmobiliario",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --turbopack --port 3001",
    "build": "prisma generate && next build --turbopack",
    "start": "next start -H 0.0.0.0",
    "start:prod": "node scripts/start-prod.mjs",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:year": "tsx prisma/seed-year-demo.ts",
    "db:setup": "prisma db push && tsx prisma/seed.ts",
    "manual:screens": "node scripts/capture-manual-screens.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@prisma/client": "^6.19.3",
    "@react-pdf/renderer": "^4.5.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jose": "^6.2.7",
    "lucide-react": "^1.28.0",
    "marked": "^18.0.9",
    "next": "15.5.22",
    "prisma": "^6.19.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.84.0",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
